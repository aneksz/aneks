/* generated by apply-theme.sh — do not edit */
:root {
    --colors: on;

    --c-bg: {{ background }};
    --c-fg: {{ foreground }};
    --c-accent: {{ accent }};
    --c-red: {{ color1 }};
    --c-green: {{ color2 }};
    --c-yellow: {{ color3 }};
    --c-blue: {{ color4 }};
    --c-purple: {{ color5 }};

    /* text: foreground faded toward background */
    --text-0: var(--bg-4);
    --text-1: var(--c-fg);
    --text-2: color-mix(in oklab, var(--c-fg) 90%, var(--c-bg));
    --text-3: color-mix(in oklab, var(--c-fg) 80%, var(--c-bg));
    --text-4: color-mix(in oklab, var(--c-fg) 60%, var(--c-bg));
    --text-5: color-mix(in oklab, var(--c-fg) 40%, var(--c-bg));

    /* backgrounds: background lifted toward foreground */
    --bg-1: color-mix(in oklab, var(--c-fg) 16%, var(--c-bg));
    --bg-2: color-mix(in oklab, var(--c-fg) 11%, var(--c-bg));
    --bg-3: color-mix(in oklab, var(--c-fg) 6%, var(--c-bg));
    --bg-4: var(--c-bg);
    --hover: color-mix(in oklab, var(--c-fg) 8%, transparent);
    --active: color-mix(in oklab, var(--c-fg) 14%, transparent);
    --active-2: color-mix(in oklab, var(--c-fg) 20%, transparent);
    --message-hover: var(--hover);

    /* accent */
    --accent-1: color-mix(in oklab, var(--c-accent) 85%, var(--c-fg));
    --accent-2: var(--c-accent);
    --accent-3: color-mix(in oklab, var(--c-accent) 85%, var(--c-bg));
    --accent-4: color-mix(in oklab, var(--c-accent) 70%, var(--c-bg));
    --accent-5: color-mix(in oklab, var(--c-accent) 55%, var(--c-bg));
    --accent-new: var(--red-2);
    --mention: linear-gradient(to right, color-mix(in hsl, var(--accent-2), transparent 90%) 40%, transparent);
    --mention-hover: linear-gradient(to right, color-mix(in hsl, var(--accent-2), transparent 95%) 40%, transparent);
    --reply: linear-gradient(to right, color-mix(in hsl, var(--text-3), transparent 90%) 40%, transparent);
    --reply-hover: linear-gradient(to right, color-mix(in hsl, var(--text-3), transparent 95%) 40%, transparent);

    /* status */
    --online: var(--green-2);
    --dnd: var(--red-2);
    --idle: var(--yellow-2);
    --streaming: var(--purple-2);
    --offline: var(--text-4);

    /* borders */
    --border-light: var(--hover);
    --border: var(--active);
    --border-hover: var(--accent-2);
    --button-border: color-mix(in oklab, var(--c-fg) 10%, transparent);

    /* base colour scales: 1 = brightest, 2 = theme colour, 3-5 = deeper */
    --red-1: color-mix(in oklab, var(--c-red) 85%, var(--c-fg));
    --red-2: var(--c-red);
    --red-3: color-mix(in oklab, var(--c-red) 85%, var(--c-bg));
    --red-4: color-mix(in oklab, var(--c-red) 70%, var(--c-bg));
    --red-5: color-mix(in oklab, var(--c-red) 55%, var(--c-bg));

    --green-1: color-mix(in oklab, var(--c-green) 85%, var(--c-fg));
    --green-2: var(--c-green);
    --green-3: color-mix(in oklab, var(--c-green) 85%, var(--c-bg));
    --green-4: color-mix(in oklab, var(--c-green) 70%, var(--c-bg));
    --green-5: color-mix(in oklab, var(--c-green) 55%, var(--c-bg));

    --blue-1: color-mix(in oklab, var(--c-blue) 85%, var(--c-fg));
    --blue-2: var(--c-blue);
    --blue-3: color-mix(in oklab, var(--c-blue) 85%, var(--c-bg));
    --blue-4: color-mix(in oklab, var(--c-blue) 70%, var(--c-bg));
    --blue-5: color-mix(in oklab, var(--c-blue) 55%, var(--c-bg));

    --yellow-1: color-mix(in oklab, var(--c-yellow) 85%, var(--c-fg));
    --yellow-2: var(--c-yellow);
    --yellow-3: color-mix(in oklab, var(--c-yellow) 85%, var(--c-bg));
    --yellow-4: color-mix(in oklab, var(--c-yellow) 70%, var(--c-bg));
    --yellow-5: color-mix(in oklab, var(--c-yellow) 55%, var(--c-bg));

    --purple-1: color-mix(in oklab, var(--c-purple) 85%, var(--c-fg));
    --purple-2: var(--c-purple);
    --purple-3: color-mix(in oklab, var(--c-purple) 85%, var(--c-bg));
    --purple-4: color-mix(in oklab, var(--c-purple) 70%, var(--c-bg));
    --purple-5: color-mix(in oklab, var(--c-purple) 55%, var(--c-bg));
}
