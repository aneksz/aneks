# Btop theme: Hackerman (dark, green/teal on near-black)
# Palette: bg #101116, fg #00ca7d, accent #00d482, bright green #00ff9c, teal #00d4b1,
#          cyan #08e1d7, blue #00a2ff, yellow #ffdd00, red #ff0000, text #D5CED9

theme[main_bg]="#101116"
theme[main_fg]="#00ca7d"
theme[title]="#00d482"
theme[hi_fg]="#00ff9c"
theme[selected_bg]="#0f2a24"
theme[selected_fg]="#00ff9c"
theme[inactive_fg]="#017562"
theme[graph_text]="#D5CED9"
theme[meter_bg]="#1a1c24"
theme[proc_misc]="#08e1d7"

theme[cpu_box]="#00d482"
theme[mem_box]="#00d4b1"
theme[net_box]="#00a2ff"
theme[proc_box]="#029790"
theme[div_line]="#017562"

theme[temp_start]="#00d4b1"
theme[temp_mid]="#ffdd00"
theme[temp_end]="#ff0000"

theme[cpu_start]="#017562"
theme[cpu_mid]="#00d482"
theme[cpu_end]="#00ff9c"

theme[free_start]="#017562"
theme[free_mid]="#00d482"
theme[free_end]="#00ff9c"

theme[cached_start]="#029790"
theme[cached_mid]="#00d4b1"
theme[cached_end]="#08e1d7"

theme[available_start]="#0059ff"
theme[available_mid]="#00a2ff"
theme[available_end]="#2eb8f8"

theme[used_start]="#ffdd00"
theme[used_mid]="#ff7a00"
theme[used_end]="#ff0000"

theme[download_start]="#02adf1"
